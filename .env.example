# Copy to .env and paste your project API token from PostHog → Project settings
VITE_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your_project_token_here
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Browser SDK: autocapture, SPA pageviews (history_change), session replay, error tracking
# Logs ingest at {VITE_PUBLIC_POSTHOG_HOST}/i/v1/logs (browser SDK + server OTLP)
